rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function isParticipant(chatId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/directMessages/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(chatId)).data.participants;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ---------------- USERNAMES ----------------
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------------- USERS ----------------
    match /users/{uid} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() || (resource.data.isOnline == true);
      allow create: if isMe(uid)
        && request.resource.data.uid == uid
        && (!( 'isPremium' in request.resource.data) || request.resource.data.isPremium == false)
        && (!( 'premiumEndDate' in request.resource.data) || request.resource.data.premiumEndDate == null)
        && (!( 'dailyVoiceMinutes' in request.resource.data) || request.resource.data.dailyVoiceMinutes == 0)
        && (!( 'followersCount' in request.resource.data) || request.resource.data.followersCount == 0)
        && (!( 'followingCount' in request.resource.data) || request.resource.data.followingCount == 0)
        && (!( 'postsCount' in request.resource.data) || request.resource.data.postsCount == 0);
      allow update: if (isMe(uid)
        && unchanged([
          'uid',
          'createdAt',
          'dailyVoiceMinutes',
          'lastResetDate',
          'friendsSyncedV3'
        ]))
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount'])
        )
        || isAdmin();
      allow delete: if isMe(uid) || isAdmin();

      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow write: if isMe(uid) || isMe(followerId);
      }
      match /following/{followingId} {
        allow read: if isSignedIn();
        allow write: if isMe(uid) || isMe(followingId);
      }
      match /blockedUsers/{blockedUserId} {
        allow read: if isMe(uid);
        allow write: if isMe(uid);
      }
      match /savedPosts/{postId} {
        allow read: if isMe(uid);
        allow write: if isMe(uid);
      }
    }

    // ---------------- FRIENDS ----------------
    match /friends/{uid}/userFriends/{friendId} {
      allow read: if isMe(uid);
      allow write: if isMe(uid) || isMe(friendId);
    }

    // ---------------- FRIEND REQUESTS ----------------
    match /friendRequests/{requestId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.fromUserId;
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId);
      allow delete: if false;
    }

    // ---------------- ROOMS ----------------
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && (
          ( ('isCustom' in resource.data) && resource.data.isCustom == true && resource.data.ownerId == request.auth.uid )
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage',
            'memberCount'
          ])
          || isAdmin()
        );
      allow delete: if isSignedIn()
        && (
          (('ownerId' in resource.data) && resource.data.ownerId == request.auth.uid)
          || isAdmin()
        );

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn()
          && (resource.data.senderId == request.auth.uid || isAdmin());
        allow delete: if isSignedIn()
          && (resource.data.senderId == request.auth.uid || isAdmin());
      }

      match /activeUsers/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn();
      }
    }

    // ---------------- DIRECT MESSAGES ----------------
    match /directMessages/{chatId} {
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());

      match /messages/{messageId} {
        allow read: if isParticipant(chatId) || isAdmin();
        allow create: if isParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isParticipant(chatId)
          && (
            resource.data.senderId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
            || isAdmin()
          );
        allow delete: if isParticipant(chatId) || isAdmin();
      }
    }

    // ---------------- POSTS ----------------
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
          || isAdmin()
        );
      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      match /likes/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isMe(uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn()
          && (resource.data.userId == request.auth.uid || isAdmin());
        allow delete: if isSignedIn()
          && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid || isAdmin());
      }
    }

    // ---------------- REPORTS ----------------
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
  }
}
